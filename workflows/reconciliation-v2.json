{
  "schema_version": 2,
  "plan": {
    "version": 2,
    "intent": "Generate a balanced journal with correct field assignments: cash debit lines must have blank Investor, blank Investor Domain, populated Bank Account, and 'Non-Dominant' Allocation Rule; receivable credit lines must have the investor name, blank Bank Account, blank Investor Domain, and 'User Provided' Allocation Rule. Ensure Batch Index is consistently 1 across all entries and JE Index matches the index sequence.",
    "steps": [
      {
        "op": "prepare_sources",
        "intent": "Extract and match source records using full names where possible, partial names where necessary, and flag uncertain matches for review. Apply numeric rule to compute outstanding amounts."
      },
      {
        "op": "emit_journal",
        "intent": "Generate journal entries with two balancing lines per investor: cash debit (Is Debit: Yes) and receivable credit (Is Debit: No), with correct field values per business rules and target conventions."
      },
      {
        "op": "write_workbook",
        "intent": "Output the final journal with all rows, including zero receipts for non-payers, maintaining the demonstrated index sequence and formatting."
      }
    ],
    "numeric_rule": {
      "version": 1,
      "intent": "Compute outstanding amount as called minus received.",
      "operation": "subtract",
      "left": "called",
      "right": "received",
      "output": "outstanding"
    },
    "matching_policy": "full_or_unique_prefix",
    "journal": {
      "include_unpaid": true,
      "currency_source": "tracker",
      "fields": {
        "Legal Entity": {
          "field": "fund.entity"
        },
        "Legal Entity Domain": {
          "field": "fund.entity_domain"
        },
        "Deal": {
          "field": "fund.deal"
        },
        "Position": {
          "field": "fund.position"
        },
        "Batch Index": {
          "line": [
            1,
            1
          ]
        },
        "Batch Type": {
          "field": "fund.batch_type"
        },
        "JE Index": {
          "field": "journal.index"
        },
        "Trans Index": {
          "field": "line.index"
        },
        "GL Date": {
          "field": "tracker.receipt_date"
        },
        "Effective Date": {
          "field": "tracker.receipt_date"
        },
        "Transaction Currency": {
          "field": "currency"
        },
        "Allocation Rule": {
          "line": [
            "Non-Dominant",
            "User Provided"
          ]
        },
        "Transaction Type": {
          "line": [
            "Cash - Received - USD",
            "Due From Investors"
          ]
        },
        "Account": {
          "account": "transaction.type"
        },
        "Is Debit": {
          "line": [
            "Yes",
            "No"
          ]
        },
        "Amount (Local)": {
          "line": [
            {
              "field": "tracker.received"
            },
            {
              "field": "tracker.received"
            }
          ]
        },
        "Amount (LE)": {
          "line": [
            {
              "field": "tracker.received"
            },
            {
              "field": "tracker.received"
            }
          ]
        },
        "Transaction Comments": {
          "concat": [
            "Capital Call Received from ",
            {
              "field": "tracker.investor"
            }
          ]
        },
        "Batch Comments": {
          "concat": [
            "Capital Call Received from ",
            {
              "field": "tracker.investor"
            }
          ]
        },
        "Bank Account": {
          "line": [
            {
              "field": "fund.bank_account"
            },
            null
          ]
        },
        "Investor": {
          "line": [
            null,
            {
              "field": "tracker.investor"
            }
          ]
        },
        "Investor Domain": {
          "line": [
            null,
            null
          ]
        },
        "Vehicle": {
          "line": [
            null,
            {
              "field": "fund.entity"
            }
          ]
        },
        "Investor Amount (LE)": {
          "line": [
            null,
            {
              "field": "tracker.received"
            }
          ]
        },
        "Investor Amount (Local)": {
          "line": [
            null,
            {
              "field": "tracker.received"
            }
          ]
        },
        "Transaction GL Reference": {
          "field": "transaction.ref"
        }
      }
    },
    "checks": [
      "account_lookup",
      "journal_balance",
      "receipt_totals",
      "source_coverage",
      "strict_headers",
      "unique_matching"
    ]
  },
  "accepted_answers": {
    "currency_conflict": {
      "decision": "reproduce_tracker_amounts_without_fx",
      "statement_currency": "EUR",
      "tracker_currency": "USD",
      "reason": "Explicit exercise assumption: reproduce the target's USD-labelled amounts without FX conversion. This does not establish an exchange rate or approve a real posting."
    }
  },
  "checks": {
    "required_fields": {
      "1": [
        "Legal Entity",
        "Legal Entity Domain",
        "Deal",
        "Position",
        "Batch Index",
        "Batch Type",
        "JE Index",
        "Trans Index",
        "Transaction Currency",
        "Allocation Rule",
        "Transaction Type",
        "Account",
        "Is Debit",
        "Amount (Local)",
        "Amount (LE)",
        "Transaction Comments",
        "Batch Comments",
        "Bank Account",
        "Transaction GL Reference"
      ],
      "2": [
        "Legal Entity",
        "Legal Entity Domain",
        "Deal",
        "Position",
        "Batch Index",
        "Batch Type",
        "JE Index",
        "Trans Index",
        "Transaction Currency",
        "Allocation Rule",
        "Transaction Type",
        "Account",
        "Is Debit",
        "Amount (Local)",
        "Amount (LE)",
        "Transaction Comments",
        "Batch Comments",
        "Investor",
        "Vehicle",
        "Investor Amount (LE)",
        "Investor Amount (Local)",
        "Transaction GL Reference"
      ]
    }
  },
  "bindings": {
    "roster": {
      "sheet": "Capital Call Tracker",
      "header_row": 7,
      "columns": {
        "id": 2,
        "investor": 4,
        "called": 10
      }
    },
    "accounts": {
      "sheet": "PCS Chart of Accounts (Global)",
      "header_row": 1,
      "columns": {
        "transaction_type": 4,
        "account": 2
      }
    },
    "constants": {
      "sheet": "Investors",
      "header_row": 1,
      "columns": {
        "entity": 1,
        "bank_account": 6,
        "batch_type": 5
      }
    }
  },
  "headers": {
    "roster.id": "ID",
    "roster.investor": "Investor",
    "roster.called": "Call #7 - Total Call",
    "tracker.received": "Amount Received",
    "tracker.outstanding": "Amount outstanding",
    "tracker.receipt_date": "Date \nas per bank statement",
    "accounts.transaction_type": "Trans Type",
    "accounts.account": "GL Account Code",
    "constants.entity": "Legal Entity",
    "constants.bank_account": "Bank Account",
    "constants.batch_type": "Batch Type",
    "fund.entity": "Legal Entity",
    "fund.entity_domain": "Legal Entity Domain",
    "fund.deal": "Deal",
    "fund.position": "Position",
    "fund.batch_type": "Batch Type",
    "fund.bank_account": "Bank Account",
    "staging.date": "Date",
    "staging.description": "Line Item Description",
    "staging.withdrawal": "Withdrawal ",
    "staging.deposit": "Deposit",
    "staging.investor": "Matched Investor"
  },
  "workflow_version": 1
}
