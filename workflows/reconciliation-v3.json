{
  "schema_version": 3,
  "workflow_version": 1,
  "plan": {
    "intent": "Match bank statement deposits to investors in the Capital Call Tracker, log received amounts and outstanding balances, and generate a balanced journal entry file with proper accounting codes and references.",
    "steps": [
      {
        "op": "match_receipts",
        "intent": "Match each deposit in the bank statement to a record in the Capital Call Tracker using the Investor name, prioritizing full name matches but accepting unique surname prefixes when necessary.",
        "table": "Capital Call Tracker",
        "name": "Investor",
        "policy": "full_or_unique_prefix"
      },
      {
        "op": "fill_columns",
        "intent": "Update the Capital Call Tracker with the date from the bank statement and the amount received for each matched deposit, then calculate the updated outstanding balance.",
        "table": "Capital Call Tracker",
        "columns": {
          "Date as per bank statement": {
            "var": "receipt.date"
          },
          "Amount Received": {
            "var": "receipt.amount"
          },
          "Amount outstanding": {
            "sub": [
              {
                "col": "Capital Call Tracker.Call #7 - Total Call"
              },
              {
                "var": "receipt.amount"
              }
            ]
          }
        }
      },
      {
        "op": "append_rows",
        "intent": "Generate two journal entry lines for each matched deposit: one for cash received and one for the reduction in the investor's outstanding balance, using the correct GL account codes and ensuring the entries balance.",
        "table": "DIU",
        "for_each": "Capital Call Tracker",
        "only_received": false,
        "lines": 2,
        "columns": {
          "Legal Entity": {
            "col": "Investors.Legal Entity"
          },
          "Legal Entity Domain": {
            "col": "Investors.Legal Entity Domain"
          },
          "Deal": {
            "col": "Investors.Deal"
          },
          "Position": {
            "col": "Investors.Position"
          },
          "Batch Index": 1,
          "Batch Type": {
            "col": "Investors.Batch Type"
          },
          "JE Index": {
            "var": "entry"
          },
          "Trans Index": {
            "var": "line"
          },
          "GL Date": {
            "var": "receipt.date"
          },
          "Effective Date": {
            "var": "receipt.date"
          },
          "Transaction Currency": {
            "unit": "Capital Call Tracker.Commitment"
          },
          "Allocation Rule": {
            "line": [
              "Non-Dominant",
              "User Provided"
            ]
          },
          "Transaction Type": {
            "line": [
              {
                "concat": [
                  "Cash - Received - ",
                  {
                    "unit": "Capital Call Tracker.Commitment"
                  }
                ]
              },
              "Due From Investors"
            ]
          },
          "Account": {
            "line": [
              {
                "lookup": {
                  "table": "PCS Chart of Accounts (Global)",
                  "where": "Trans Type",
                  "equals": {
                    "out": "Transaction Type"
                  },
                  "return": "GL Account Code"
                }
              },
              {
                "lookup": {
                  "table": "PCS Chart of Accounts (Global)",
                  "where": "Trans Type",
                  "equals": {
                    "out": "Transaction Type"
                  },
                  "return": "GL Account Code"
                }
              }
            ]
          },
          "Is Debit": {
            "line": [
              "Yes",
              "No"
            ]
          },
          "Amount (Local)": {
            "line": [
              {
                "var": "receipt.amount"
              },
              {
                "var": "receipt.amount"
              }
            ]
          },
          "Amount (LE)": {
            "line": [
              {
                "var": "receipt.amount"
              },
              {
                "var": "receipt.amount"
              }
            ]
          },
          "Transaction Comments": {
            "line": [
              {
                "concat": [
                  "Capital Call Received from ",
                  {
                    "col": "Capital Call Tracker.Investor"
                  }
                ]
              },
              {
                "concat": [
                  "Capital Call Received from ",
                  {
                    "col": "Capital Call Tracker.Investor"
                  }
                ]
              }
            ]
          },
          "Batch Comments": {
            "line": [
              {
                "concat": [
                  "Capital Call Received from ",
                  {
                    "col": "Capital Call Tracker.Investor"
                  }
                ]
              },
              {
                "concat": [
                  "Capital Call Received from ",
                  {
                    "col": "Capital Call Tracker.Investor"
                  }
                ]
              }
            ]
          },
          "Bank Account": {
            "line": [
              {
                "col": "Investors.Bank Account"
              },
              null
            ]
          },
          "Investor": {
            "line": [
              null,
              {
                "col": "Capital Call Tracker.Investor"
              }
            ]
          },
          "Investor Domain": {
            "line": [
              null,
              null
            ]
          },
          "Vehicle": {
            "line": [
              null,
              {
                "col": "Investors.Legal Entity"
              }
            ]
          },
          "Investor Amount (LE)": {
            "line": [
              null,
              {
                "var": "receipt.amount"
              }
            ]
          },
          "Investor Amount (Local)": {
            "line": [
              null,
              {
                "var": "receipt.amount"
              }
            ]
          },
          "Transaction GL Reference": {
            "line": [
              {
                "var": "row"
              },
              {
                "var": "row"
              }
            ]
          }
        }
      },
      {
        "op": "append_rows",
        "intent": "Create a staging table to record the bank statement deposits with their matched investor, date, and amount, for audit and reconciliation purposes.",
        "table": "Bank Statement Staging",
        "for_each": "statement",
        "only_received": false,
        "lines": 1,
        "columns": {
          "Date": {
            "var": "receipt.date"
          },
          "Line Item Description": {
            "var": "receipt.description"
          },
          "Withdrawal": null,
          "Deposit": {
            "var": "receipt.amount"
          },
          "Matched Investor": {
            "col": "Capital Call Tracker.Investor"
          }
        }
      }
    ]
  },
